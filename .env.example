# VibeSeek - Week 3 environment variables
# Copy this file to ".env" and fill in the values. .env is git-ignored.
# On Hugging Face Spaces, set these same keys as repository "Secrets" instead.

# --- Pinecone (cloud vector DB) --------------------------------------------- #
# Create a free Starter project at https://app.pinecone.io (no credit card).
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=vibeseek
PINECONE_CLOUD=aws            # free Starter plan lives on AWS
PINECONE_REGION=us-east-1     # ...in us-east-1

# --- Cloudinary (frame thumbnail hosting) ----------------------------------- #
# Sign up free at https://cloudinary.com (no credit card). Values are on the
# dashboard "Account Details" card.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=vibeseek/frames

# --- Upstash Redis (job queue + global index registry) ---------------------- #
# Create a free database at https://console.upstash.com (no credit card).
# Use the "rediss://" TLS connection string (Redis protocol, NOT the REST URL).
REDIS_URL=rediss://default:your-token@your-db.upstash.io:6379

# --- Groq (OPTIONAL — AI-written summaries, free tier) ---------------------- #
# Get a free API key at https://console.groq.com/keys (no credit card).
# If left blank, Skim falls back to a free offline summary (no AI, no key needed).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Local working directory (temp frames before upload) -------------------- #
VIBESEEK_DATA_DIR=vibeseek_data
