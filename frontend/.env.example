# Skim frontend
# Copy to ".env" for local dev, or set this in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# Base URL of the backend API. Leave unset locally to default to localhost:8000.
# In production, point it at your Hugging Face Space:
VITE_API_BASE_URL=https://your-username-vibeseek.hf.space
